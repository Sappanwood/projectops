{
  "name": "projectops",
  "version": "0.0.0",
  "private": true,
  "description": "Local project operations for humans and coding agents",
  "type": "module",
  "bin": {
    "pops": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "node --import tsx src/cli.ts",
    "preworkbench": "npm run build",
    "workbench": "node --import tsx src/workbench.ts",
    "test": "npm run build && node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && node scripts/buildAssets.mjs",
    "start": "node dist/cli.js",
    "test:e2e": "npm run build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.85.0",
    "@earendil-works/pi-server": "0.85.0"
  }
}
