{
  "name": "projectops",
  "version": "0.0.0",
  "private": true,
  "description": "Local project operations for humans and coding agents",
  "type": "module",
  "bin": {
    "pops": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "node --import tsx src/cli.ts",
    "preworkbench": "npm run build",
    "workbench": "node --import tsx src/workbench.ts",
    "test": "npm run build && npm run test:unit",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && node scripts/buildAssets.mjs",
    "start": "node dist/cli.js",
    "test:e2e": "npm run build && npm run test:browser",
    "lint": "biome lint . --error-on-warnings",
    "format:check": "biome format .",
    "format": "biome format --write .",
    "test:unit": "node --import tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "quality": "npm run lint && npm run format:check && npm run typecheck",
    "quality:full": "npm run quality && npm run build && npm run test:unit && npm run test:browser",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.85.0",
    "@earendil-works/pi-server": "0.85.0",
    "mermaid": "^11.17.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "files": [
    "dist"
  ]
}
